# AWS/Bedrock (extraction + eval judge — NOT live answer path)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
BEDROCK_MODEL=us.anthropic.claude-opus-4-6-v1          # one-time offline extraction
BEDROCK_MODEL_JUDGE=us.anthropic.claude-sonnet-4-6     # eval judge

# Live answer LLM (open weights). Ladder: experiments/EXPERIMENT_SUMMARY.md §5
LLM_BACKEND=local
# Winner: Qwen3.6-27B Q4_K_M — 12/12 assignment, 16/20 held-out, faithfulness 0.897,
# on one A10G (18.5GB). The three context-shaping blocks default OFF (§6).
MODEL_PATH=models/Qwen_Qwen3.6-27B-Q4_K_M.gguf
# Thinking ON; LLM_THINK_BUDGET=0 = natural CoT. Both alternatives score 7/12 (§7).
LLM_ENABLE_THINKING=true
LLM_THINK_BUDGET=0
# Faster alternatives, 5-6/12: Mistral-Small-24B, gemma-2-27b-it
# MODEL_PATH=models/Mistral-Small-24B-Instruct-2501-Q4_K_M.gguf
# MODEL_PATH=models/gemma-2-27b-it-Q4_K_M.gguf
# Prior default, 5-7/12:
# MODEL_PATH=models/Qwen2.5-14B-Instruct-Q4_K_M.gguf

# GPU plan: two GPUs visible; generation runs on exactly ONE (LLM_MAIN_GPU, no split),
# embedder + reranker on the other (EMBED_DEVICE)
CUDA_VISIBLE_DEVICES=1,2
LLM_MAIN_GPU=1
# Answer-phase tokens after </think> (prompt + think_budget + this must fit n_ctx=16384).
LLM_MAX_TOKENS=4096
EMBED_DEVICE=cuda:0

# Embedder (set after embedder_comparison.py)
# winner: embedder_comparison.py — recall@10 0.525, mrr@10 0.500 (vs nemotron 0.389, 0.335)
EMBEDDER_MODEL=Hanno-Labs/dinghy-law-0.6b-v1

# Reranker (set after reranker_comparison.py)
# NOTE: lxyuan/LegalBenchRAG-Ettin-150M-Reranker checkpoint is missing its classifier
# head weights (verified 2026-09-26) — unusable as CrossEncoder. MiniLM is the working default.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
RERANKER_TOP_K=10
RERANKER_BATCH_SIZE=32
